PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB — https://www.mongodb.com/atlas
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/khan-scents?retryWrites=true&w=majority

# Auth
JWT_SECRET=use-a-long-random-string-here
ADMIN_EMAIL=admin@khanscents.com
ADMIN_PASSWORD=change-this-password

# Cloudinary — https://cloudinary.com (free tier) — product image uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend — https://resend.com/api-keys
# IMPORTANT: Without a verified domain, Resend only delivers to your Resend signup email.
# Set ADMIN_EMAIL to that same email so you receive new-order alerts.
# To email ANY customer: verify a domain at resend.com/domains, then use:
# RESEND_FROM=Khan Scents <orders@yourdomain.com>
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM=Khan Scents <onboarding@resend.dev>
