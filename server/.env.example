PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB — https://www.mongodb.com/atlas
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/khan-scents?retryWrites=true&w=majority

# Auth
JWT_SECRET=use-a-long-random-string-here
ADMIN_EMAIL=admin@khanscents.com
ADMIN_PASSWORD=change-this-password

# Resend — https://resend.com/api-keys
# Free without a domain: use onboarding@resend.dev (emails only go to your Resend account email)
# With a verified domain: set RESEND_FROM to e.g. Khan Scents <orders@yourdomain.com>
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM=Khan Scents <onboarding@resend.dev>
