PORT=5000
NODE_ENV=development
# Comma-separated frontend origins allowed by CORS (no trailing slash)
CLIENT_URL=http://localhost:5173,https://khanscents.shop,https://www.khanscents.shop

# MongoDB — https://www.mongodb.com/atlas
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/khan-scents?retryWrites=true&w=majority

# Auth
JWT_SECRET=use-a-long-random-string-here
ADMIN_EMAIL=khanscentsofficial@gmail.com
ADMIN_PASSWORD=change-this-password

# Cloudinary — https://cloudinary.com (free tier) — product image uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend — send FROM the verified domain; replies go to ADMIN_EMAIL (Gmail cannot be the From address)
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM=Khan Scents Official <orders@khanscents.shop>
